# Tebex Secrets — NUR serverseitig, niemals im Client-Code verwenden.
# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die ".env" wird von .gitignore ausgeschlossen und niemals committet.

# Headless API "Private Key" (aus dem Tebex Control Panel -> Integrations -> Headless API).
# Wird fuer aktive Abos / Tiers benoetigt.
TEBEX_PRIVATE_KEY=

# Game Server "Secret" (aus creator.tebex.io -> Game Servers -> FiveM Server).
# Wird fuer die Kaufhistorie (letzter Kauf) benoetigt.
TEBEX_SECRET=

# ── Admin Panel ────────────────────────────────────────────────────────────
# Wer Admin-Zugriff hat, wird primaer in der Supabase-Tabelle "admin_roster"
# verwaltet (server-only, nie im Client sichtbar) und ueber Management -> CFX-IDs
# gepflegt. Es gibt KEINE Admin-IDs im Anwendungscode oder in dieser Datei.
# Der geschuetzte Standard-Account (LODStudios, Founder) wird beim Ausfuehren von
# supabase/schema.sql automatisch angelegt. Weitere geschuetzte Accounts:
#     npm run db:founder -- CFX_ID "Name"
# Der Standard-Account "LODStudios" ist eine geschuetzte Zeile in der Datenbank;
# dass er nie geloescht oder geaendert werden kann, erzwingt die Datenbank selbst.

# ── Supabase — die Datenbank fuer ALLES ────────────────────────────────────
# Partner, Newsletter-Abonnenten, E-Mail-Vorlagen, Logs, Admin-Liste + Rollen,
# Wunschlisten und das Empfehlungsprogramm.
#
# Einrichtung (einmalig):
#  1) https://supabase.com -> neues Projekt anlegen.
#  2) Im Projekt: SQL Editor -> "New query" -> den kompletten Inhalt von
#     supabase/schema.sql einfuegen -> "Run".
#  3) Project Settings -> API:
#       "Project URL"             -> SUPABASE_URL
#       "service_role" (secret!)  -> SUPABASE_SERVICE_ROLE_KEY
#  4) Pruefen:  npm run db:check
#  5) Alte Daten aus JSONBin uebernehmen (nur einmal noetig):
#       npm run db:migrate
#
# WICHTIG: Der service_role-Key umgeht alle Sicherheitsregeln der Datenbank.
# Er darf NIE im Browser landen: kein VITE_-Praefix, nicht committen, nicht
# weitergeben. Der "anon"-Key wird NICHT benoetigt und hat keinerlei Zugriff.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# KI-Assistent (E-Mail-Entwuerfe) laeuft kostenlos & tokenlos ueber Pollinations.
# Kein Key noetig.

# Gmail-API (E-Mail-Versand: Kontakt-Seite / Bewerbungen) via OAuth2.
# WICHTIG: Ein reiner API-Key reicht NICHT — Google verlangt fuer den Versand
# OAuth2. So bekommst du die Werte:
#  1) https://console.cloud.google.com -> Projekt anlegen -> Gmail API aktivieren.
#  2) OAuth-Zustimmungsbildschirm einrichten, Scope
#     https://www.googleapis.com/auth/gmail.send hinzufuegen.
#  3) OAuth-Client-ID (Typ: Desktop/Web) erstellen -> Client-ID + Secret unten eintragen.
#  4) Refresh-Token einmalig erzeugen (z. B. via https://developers.google.com/oauthplayground
#     mit eigenem Client oder einem lokalen Consent-Flow) und unten eintragen.
#  5) GMAIL_SENDER = die Gmail-Adresse, von der gesendet wird.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=contact.lodstudios@gmail.com

# ── Hero-Hintergrundvideo ───────────────────────────────────────────────────
# Oeffentliche URL einer MP4 (H.264, faststart, ohne Ton), z. B. auf dem
# Strato-Webspace. Wird auf allen Hero-Bereichen als natives <video> abgespielt.
# Leer lassen -> Fallback auf public/videos/hero.mp4 bzw. YouTube-Embed.
# Empfohlene Kodierung: siehe public/videos/README.txt (Ziel < ~10 MB).
VITE_HERO_VIDEO_URL=https://shopvideos.lodstudios.cloud/hero.mp4
# Optional: eigenes Video fuer die Store-Uebersicht (leer -> VITE_HERO_VIDEO_URL).
VITE_STORE_VIDEO_URL=https://shopvideos.lodstudios.cloud/shop.mp4
# Optional: eigenes Video fuer Jobs / Bewerbung (leer -> VITE_HERO_VIDEO_URL).
# Wird nur bis Sekunde 52 abgespielt und startet dann von vorn (loopEnd in jobs.*.tsx).
VITE_JOBS_VIDEO_URL=https://shopvideos.lodstudios.cloud/jobs.mp4
# Optional: eigenes Video fuer die Team-Seite (leer -> VITE_HERO_VIDEO_URL).
VITE_TEAM_VIDEO_URL=https://shopvideos.lodstudios.cloud/team.mp4
# Optional: eigenes Video fuer die Referral-/Rewards-Seiten (leer -> VITE_HERO_VIDEO_URL).
VITE_REFERRAL_VIDEO_URL=https://shopvideos.lodstudios.cloud/rewards.mp4
